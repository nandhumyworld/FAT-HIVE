# Normalize everything to LF in the repo so Linux containers (nginx/Docker) are happy
* text=auto eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.svg   text eol=lf
*.md    text eol=lf
*.conf  text eol=lf
Dockerfile text eol=lf
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
